<?xml version="1.0" encoding="utf-8"?>
<!-- تطبيق شاشة المطبخ/المجهز: نفس صفحة المطبخ، وتشتغل بنت أو بدون نت على نفس الراوتر ويا الكاشير (شبكة المطعم). ما يطلب أي إذن حساس -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- الأيقونة بالشاشة الرئيسية من وحدة من الاثنين تحت (مو من الصفحة نفسها) -->
        <activity android:name=".MainActivity">
            <intent-filter tools:node="removeAll" />
        </activity>
        <!-- كل شاشة بلونها واسمها: المطبخ فيروزي، المجهز بنفسجي. الصفحة تختار (KitchenIcon) — وحدة بس شغّالة -->
        <activity-alias android:name=".KitchenLauncher" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
            android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".PrepLauncher" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:label="@string/app_name_prep" android:icon="@mipmap/ic_launcher_prep" android:roundIcon="@mipmap/ic_launcher_prep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
