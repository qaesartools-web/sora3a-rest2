{
  "name": "sora3a-cashier",
  "productName": "Sora3a Cashier",
  "version": "1.0.0",
  "description": "سرعة — برنامج الكاشير للويندوز مع طباعة مباشرة لكل قسم",
  "main": "main.js",
  "author": "Sora3a",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "iq.sora3a.cashier",
    "productName": "Sora3a Cashier",
    "files": [
      "main.js",
      "preload.js",
      "printer.js",
      "offline.html",
      "simulator.html",
      "simulator-preload.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "sora3a-cashier-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sora3a Cashier",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qaesartools-web",
        "repo": "sora3a-rest2",
        "releaseType": "release"
      }
    ]
  }
}
